Enum TrafficLight { RED, YELLOW, GREEN }

Class TrafficSignal
    Attribute currentLight : TrafficLight

    Constructor()
        currentLight = RED
    
    Method switchLight()
        if currentLight == RED
            currentLight = GREEN
        else if currentLight == GREEN
            currentLight = YELLOW
        else if currentLight == YELLOW
            currentLight = RED
    
    Method showLight()
        print "Current Signal: " + currentLight

Main
    Create object signal = new TrafficSignal()
    Loop 5 times
        signal.showLight()
        wait 2 seconds
        signal.switchLight()
